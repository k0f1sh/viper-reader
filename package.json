{
  "name": "viper-reader",
  "version": "0.1.0",
  "private": true,
  "description": "Retro message-board-style technical RSS reader desktop app",
  "license": "MIT",
  "author": "k0f1sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k0f1sh/viper-reader.git"
  },
  "homepage": "https://github.com/k0f1sh/viper-reader#readme",
  "main": "dist/main/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:app": "npm run build && electron .",
    "dev:electron": "npm run build:main && electron .",
    "start": "electron .",
    "build": "npm run build:main && vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "package:linux": "npm run build && electron-builder --linux dir --publish never",
    "install:local": "npm run package:linux && bash scripts/install-local.sh",
    "test": "npm run build:main && node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.main.json --noEmit",
    "resident-prompt": "node scripts/feed-resident-prompt.mjs"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.18.2",
    "@google/genai": "^1.9.0",
    "@mozilla/readability": "^0.6.0",
    "cheerio": "^1.0.0",
    "dotenv": "^17.4.2",
    "jsdom": "^29.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "robots-parser": "^3.0.1",
    "rss-parser": "^3.13.0",
    "undici": "^7.29.0"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.3",
    "@types/node": "^22.10.7",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  },
  "build": {
    "appId": "dev.yushi.viperreader",
    "productName": "ViperReader",
    "executableName": "viper-reader",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets/icon.png",
        "to": "icon.png"
      }
    ],
    "linux": {
      "target": "dir",
      "category": "Network",
      "icon": "assets/icon.png"
    }
  }
}
